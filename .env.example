# Web login credentials. Change these before publishing the service.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# SQLite data directory. Docker Compose mounts this directory as /data.
DATA_DIR=./data

# Scheduler defaults. Individual sites can override the interval.
DEFAULT_CHECK_INTERVAL_SECONDS=300
HTTP_TIMEOUT_SECONDS=15

# Telegram values seed the initial SQLite settings. They can also be managed in
# the web console after startup.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
